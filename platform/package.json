{
  "name": "orin-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile",
    "packages/contracts"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @orin/api",
    "dev:web": "npm run dev -w @orin/web",
    "dev:mobile": "npm run start -w @orin/mobile",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:web": "npm run build -w @orin/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
